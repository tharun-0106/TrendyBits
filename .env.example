# Copy to .env (docker compose reads it automatically) or export in your shell.
OLLAMA_URL=http://localhost:11434
TRENDYBITS_USE_OLLAMA=auto                 # auto | 1 | 0  (0 forces the deterministic fallback engine)
TRENDYBITS_SUMMARIZER_MODEL=qwen:4b        # Pipeline A (or qwen2.5:3b)
TRENDYBITS_REASONER_MODEL=deepseek-r1:8b   # Pipeline B (gemma2:9b, llama3.1:8b)
TRENDYBITS_JUDGE_MODEL=mistral:7b          # LLM-as-a-judge for DeepEval
TRENDYBITS_USE_SBERT=auto                  # auto | 0
TRENDYBITS_LIME_SAMPLES=300
TRENDYBITS_MMR_LAMBDA=0.7
TRENDYBITS_PUBLISHER_PENALTY=0.15
INSTALL_ML=false                           # docker build arg: true installs torch/transformers/SBERT/FAISS/deepeval
# When running the API in Docker but the web UI with `npm run dev`:
# VITE_API_PROXY=http://localhost:8000
